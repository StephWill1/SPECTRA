###################################################################################
################# STAC search + sampling helpers (Sentinel-2 L2A) #################
###################################################################################

pc_url <- "https://planetarycomputer.microsoft.com/api/stac/v1"

# Sentinel-2 L2A surface-reflectance asset names for the 6 bands the game uses
s2_assets <- c(blue = "B02", green = "B03", red = "B04",
               nir = "B08", swir1 = "B11", swir2 = "B12")

search_scene <- function(lon, lat, date, collection = "sentinel-2-l2a", window_days = 10) {
  pt  <- st_sfc(st_point(c(lon, lat)), crs = 4326)
  bb  <- st_bbox(st_buffer(st_transform(pt, 3857), 300) |> st_transform(4326))
  dr  <- paste0(as.Date(date) - window_days, "/", as.Date(date) + window_days)
  it  <- stac(pc_url) |>
    stac_search(collections = collection, bbox = as.numeric(bb),
                datetime = dr, limit = 10) |>
    post_request()
  # sign URLs for Planetary Computer access
  if (requireNamespace("rstac", quietly = TRUE) && !is.null(it$features) && length(it$features) > 0) {
    it <- items_sign(it, sign_fn = sign_planetary_computer())
  }
  it
}

extract_s2_pixel <- function(lon, lat, date) {
  items <- search_scene(lon, lat, date, "sentinel-2-l2a")
  if (is.null(items$features) || length(items$features) == 0) {
    warning("No Sentinel-2 scene found near ", lon, ",", lat, " / ", date)
    return(NULL)
  }
  # sort by cloud cover if available, take the clearest scene
  cc <- sapply(items$features, function(f) f$properties$`eo:cloud_cover` %||% 100)
  best <- items$features[[order(cc)[1]]]
  
  pt <- vect(cbind(lon, lat), crs = "EPSG:4326")
  vals <- sapply(names(s2_assets), function(k) {
    href <- best$assets[[s2_assets[[k]]]]$href
    r <- rast(paste0("/vsicurl/", href))
    pt_p <- project(pt, crs(r))
    v <- terra::extract(r, pt_p)[, 2]
    v / 10000 * 100   # Sentinel-2 L2A: DN/10000 = reflectance (0-1) -> percent
  })
  round(vals, 1)
}

`%||%` <- function(a, b) if (is.null(a)) b else a

###################################################################################
######################### Landsat Collection 2 L2 variant #########################
###################################################################################
# different asset names + scale/offset
# Use this instead of / alongside Sentinel-2 for older imagery (e.g. fire
# scars from years before Sentinel-2's 2015 launch).

landsat_assets <- c(blue = "SR_B2", green = "SR_B3", red = "SR_B4",
                    nir = "SR_B5", swir1 = "SR_B6", swir2 = "SR_B7")

extract_landsat_pixel <- function(lon, lat, date) {
  items <- search_scene(lon, lat, date, "landsat-c2-l2")
  if (is.null(items$features) || length(items$features) == 0) {
    warning("No Landsat scene found near ", lon, ",", lat, " / ", date)
    return(NULL)
  }
  cc <- sapply(items$features, function(f) f$properties$`eo:cloud_cover` %||% 100)
  best <- items$features[[order(cc)[1]]]
  pt <- vect(cbind(lon, lat), crs = "EPSG:4326")
  vals <- sapply(names(landsat_assets), function(k) {
    href <- best$assets[[landsat_assets[[k]]]]$href
    r <- rast(paste0("/vsicurl/", href))
    pt_p <- project(pt, crs(r))
    dn <- terra::extract(r, pt_p)[, 2]
    # Landsat Collection 2 Level-2 scale/offset -> surface reflectance (0-1)
    (dn * 0.0000275 - 0.2) * 100
  })
  round(vals, 1)
}

###################################################################################
############################## Build the puzzle bank ##############################
###################################################################################

bank <- lapply(seq_len(nrow(sites)), function(i) {
  s <- sites[i, ]
  bands <- tryCatch(extract_s2_pixel(s$lon, s$lat, s$date), error = function(e) NULL)
  if (is.null(bands)) return(NULL)
  meta <- class_meta[[s$class_id]]
  list(
    id    = s$class_id,
    name  = meta$name,
    bands = unname(bands),   # order: blue, green, red, nir, swir1, swir2
    hints = meta$hints,
    note  = meta$note
  )
})
bank <- Filter(Negate(is.null), bank)

write_json(bank, "puzzle-bank.json", auto_unbox = TRUE, pretty = TRUE)
cat("Wrote puzzle-bank.json with", length(bank), "entries.\n")

# Drop puzzle-bank.json in the same folder as spectra.html,the game already 
# tries to fetch('puzzle-bank.json') on load and will use these real values 
# instead of its synthetic defaults whenever it finds a file shaped like this.
