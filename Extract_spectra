# Builds a real puzzle-bank.json for SPECTRA by sampling actual Sentinel-2,
# Landsat, and/or NAIP pixels at reference locations, via the Microsoft
# Planetary Computer STAC catalog (free, no API key required).

# NOTE: this was written and formatted here but NOT executed here. This
# sandbox has no network access to STAC/Earth-data endpoints. Run and debug
# it locally in RStudio, where you already have working geospatial access.

# Packages needed:
install.packages(c("rstac", "terra", "sf", "jsonlite"))

require(rstac)
require(terra)
require(sf)
require(jsonlite)

###################################################################################
################################# Reference Sites #################################
###################################################################################
# Reference sites: point + acquisition date + the class label you want
# that pixel to represent.`date` should be a cloud-free scene date near your point.

sites <- data.frame(
  id       = c("healthy_1", "stressed_1", "burned_1", "impervious_1", "soil_1", "water_1"),
  lon      = c(-123.62, -122.10, -121.75, -122.68, -105.10, -122.90),
  lat      = c(  45.82,   44.60,   44.10,   45.53,   40.20,   45.50),
  date     = c("2024-07-15","2023-08-20","2021-09-05","2024-07-01","2024-07-01","2024-06-01"),
  class_id = c("healthy","stressed","burned","impervious","soil","water"),
  stringsAsFactors = FALSE
)

# Human-facing metadata for each class, edit if needed, this is what shows in
# the game's hint log and result note.
class_meta <- list(
